# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment label (development | staging | production)
NEXT_PUBLIC_APP_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Connection string for your database (never expose to the client)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ─── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign/verify session tokens — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-strong-random-secret
